<!DOCTYPE html>
<html lang="pt-br">
<head>
    <link rel="icon" type="image/png" href="/img/logo-bikonfig-32.png">
    <link rel="apple-touch-icon" href="/img/logo-bikonfig-180.png">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catalogo - Bikonfig</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/estilo.css">
</head>
<body>
    <header class="cabecalho">
        <div class="container">
            <a href="/" class="logo"><img class="logo-imagem" src="/img/logo-bikonfig-80.webp" alt="" width="40" height="40" decoding="async"><span>Bikonfig</span></a>
            <button type="button" class="menu-toggle" id="menuToggle" aria-expanded="false" aria-controls="navPrincipal" aria-label="Abrir menu">
                <span></span><span></span><span></span>
            </button>
            <nav class="nav" id="navPrincipal">
                <span class="usuario-nome"><%= usuario.nome %></span>
                <a href="/home">Home</a>
                <a href="/catalogo">Catalogo</a>
                <a href="/catalogo/configurador">Configurador</a>
                <a href="/catalogo/minhas-configuracoes">Minhas configs</a>
                <% if (usuario.isAdmin) { %><a href="/admin/revisao">Revisão</a><% } %>
                <form method="POST" action="/logout" class="form-sair"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"><button type="submit" class="sair">Sair</button></form>
            </nav>
        </div>
    </header>

    <main class="container">
        <div class="catalogo-header">
            <h1>Catalogo de Pecas</h1>
            <p>Selecione os componentes para sua bicicleta</p>

            <div class="monitor-preco">
                <span>Preços consultados nas coletas. Confira a data de cada oferta e confirme o valor na loja.</span>
            </div>
        </div>

        <form method="GET" action="/catalogo" class="busca-form" role="search">
            <input
                type="search"
                name="busca"
                value="<%= busca %>"
                placeholder="Buscar por peça, fabricante ou loja (ex: quadro, Shimano...)"
                aria-label="Buscar por peça, fabricante ou loja">
            <button type="submit" class="btn-principal">Buscar</button>
            <% if (busca) { %>
                <a href="/catalogo" class="btn-secundario">Limpar</a>
            <% } %>
        </form>

        <% if (typeof paginacao !== 'undefined' && paginacao.total > 0) { %>
            <p role="status">Mostrando <%= (paginacao.pagina - 1) * paginacao.tamanho + 1 %>–<%= Math.min(paginacao.pagina * paginacao.tamanho, paginacao.total) %> de <%= paginacao.total %> ofertas.</p>
        <% } %>
        <% if (vazio) { %>
            <div class="catalogo-vazio">
                <div class="icone-estado">
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M33 8c-4 0-7.5 2.7-8.6 6.4L11 27.8a4.6 4.6 0 1 0 6.5 6.5L30.9 21c3.7-1.1 6.4-4.6 6.4-8.6 0-.8-.1-1.6-.3-2.4l-5 5-3.5-3.5 5-5c-.8-.2-1.6-.3-2.4-.3-.7 0-1.4.1-2.1.3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
                        <circle cx="14.5" cy="31" r="1.6" fill="currentColor"/>
                    </svg>
                </div>
                <h2>Catalogo em construcao</h2>
                <p>Estamos adicionando as melhores pecas para voce</p>

                <div class="recursos">
                    <div class="recurso">
                        <h3>Alertas de compatibilidade</h3>
                        <p>Confira as comparações disponíveis e as especificações pendentes.</p>
                    </div>
                    <div class="recurso">
                        <h3>Consulta de preços</h3>
                        <p>Veja a data da consulta e confirme o valor na loja antes de comprar.</p>
                    </div>
                    <div class="recurso">
                        <h3>PDF de montagem</h3>
                        <p>Leve sua lista de peças para conferir com o mecânico.</p>
                    </div>
                    <div class="recurso">
                        <h3>Resumo da montagem</h3>
                        <p>Acompanhe as peças selecionadas e o orçamento.</p>
                    </div>
                </div>

                <a href="/catalogo/configurador" class="btn-secundario">
                    Ir para o configurador
                </a>
            </div>
        <% } else if (semResultadoDaBusca) { %>
            <div class="catalogo-vazio">
                <div class="icone-estado">
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="21" cy="21" r="12" stroke="currentColor" stroke-width="2.5"/>
                        <line x1="30" y1="30" x2="40" y2="40" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    </svg>
                </div>
                <h2>Nenhuma peça encontrada para "<%= busca %>"</h2>
                <p>Tente buscar por outro nome, fabricante ou loja.</p>
                <a href="/catalogo" class="btn-secundario">Ver catálogo completo</a>
            </div>
        <% } else { %>
            <div class="grid-produtos">
                <% for (let i = 0; i < produtos.length; i++) { %>
                    <div class="produto-card">
                        <div class="produto-imagem">
                            <img src="<%= produtos[i].imagem || produtos[i].imagemFallback %>" data-imagem-fallback="<%= produtos[i].imagemFallback %>" alt="<%= produtos[i].nome %>" loading="<%= i < 3 ? 'eager' : 'lazy' %>" decoding="async" width="240" height="240">
                        </div>
                        <h3><%= produtos[i].nome %></h3>
                        <% if (produtos[i].variante_id) { %><p class="loja">Variação: <%= produtos[i].variante || 'Padrão' %></p><% } %>
                        <% if (produtos[i].sku) { %><p class="loja">SKU: <%= produtos[i].sku %></p><% } %>
                        <p class="preco">R$ <%= produtos[i].preco.toFixed(2) %></p>
                        <p class="loja"><%= produtos[i].preco_verificado_em ? 'Preço consultado em ' + new Date(produtos[i].preco_verificado_em).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) + ' (Brasília)' : 'Preço sem data de consulta registrada' %></p>
                        <p class="fabricante">Fabricante: <%= produtos[i].fabricante || 'Não informado' %></p>
                        <p class="loja">Loja: <%= produtos[i].loja %></p>
                        <div class="estoque">
                            <% if (produtos[i].em_estoque === true) { %>
                                <span class="em-estoque">Em estoque na última coleta</span>
                            <% } else if (produtos[i].em_estoque === false) { %>
                                <span class="sem-estoque">Sem estoque na última coleta</span>
                            <% } else { %>
                                <span class="estoque-desconhecido">Disponibilidade desconhecida</span>
                            <% } %>
                        </div>
                        <% if (produtos[i].em_estoque === false) { %>
                        <button type="button" class="btn-adicionar" disabled>Indisponível para seleção</button>
                        <% } else { %>
                        <a class="btn-adicionar" href="/catalogo/configurador?produto=<%= encodeURIComponent(produtos[i].id) %>&amp;subcategoria=<%= encodeURIComponent(produtos[i].subcategoria || '') %>">
                            Configurar com essa peça
                        </a>
                        <% } %>
                        <% if (produtos[i].estoque_verificado_em) { %>
                            <p class="loja">Consulta de estoque: <%= new Date(produtos[i].estoque_verificado_em).toISOString().slice(0, 10) %></p>
                        <% } %>
                    </div>
                <% } %>
            </div>
        <% } %>

        <% if (typeof paginacao !== 'undefined' && paginacao.paginas > 1) { %>
            <nav class="paginacao" aria-label="Páginas do catálogo">
                <% if (paginacao.pagina > 1) { %><a class="btn-secundario" rel="prev" href="/catalogo?pagina=<%= paginacao.pagina - 1 %>&amp;busca=<%= encodeURIComponent(busca) %>">Anterior</a><% } %>
                <span aria-current="page">Página <%= paginacao.pagina %> de <%= paginacao.paginas %></span>
                <% if (paginacao.pagina < paginacao.paginas) { %><a class="btn-secundario" rel="next" href="/catalogo?pagina=<%= paginacao.pagina + 1 %>&amp;busca=<%= encodeURIComponent(busca) %>">Próxima</a><% } %>
            </nav>
        <% } %>
        <div class="acoes">
            <a href="/catalogo/configurador" class="btn-principal">
                Iniciar configuração
            </a>
        </div>
    </main>

    <footer class="rodape">
        <div class="container">
            <p>Bikonfig - Configurador de bicicletas</p>
        </div>
    </footer>

    <script src="/js/app.js"></script>
</body>
</html>
