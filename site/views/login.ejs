<% const usaFirebase = typeof firebaseUi !== 'undefined' && firebaseUi; const temFirebase = typeof firebaseDisponivel !== 'undefined' && firebaseDisponivel; const sufixoLegado = temFirebase && !usaFirebase ? '?legado=1' : ''; %>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Bikonfig</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/estilo.css">
</head>
<body>
    <header class="cabecalho">
        <div class="container">
            <a href="/" class="logo">Bikonfig</a>
        </div>
    </header>

    <main class="container">
        <div class="login-box">
            <h1>Entrar no Bikonfig</h1>
            <p>Monte sua bicicleta com peças compativeis</p>

            <% if (erro) { %>
                <div class="erro"><%= erro %></div>
            <% } %>

            <form method="POST" action="<%= usaFirebase ? '/auth/firebase/session' : '/login' + sufixoLegado %>" data-firebase="<%= usaFirebase %>" data-operacao="login" class="form-login">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <% if (usaFirebase) { %>
                <label class="campo-label" for="email">E-mail</label>
                <input type="email" id="email" name="email" placeholder="E-mail" autocomplete="username" maxlength="254" required>
                <% } else { %>
                <label class="campo-label" for="usuario">Usuário</label>
                <input type="text" id="usuario" name="usuario" placeholder="Usuario" autocomplete="username" required>

                <% } %>

                <label class="campo-label" for="senha">Senha</label>
                <div class="campo-senha">
                    <input type="password" id="senha" name="senha" placeholder="Senha" autocomplete="current-password" required>
                    <button type="button" class="btn-mostrar-senha" data-alvo="senha" aria-label="Mostrar senha"><svg class="icone-olho" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 10s3.2-6 9-6 9 6 9 6-3.2 6-9 6-9-6-9-6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="10" cy="10" r="2.6" stroke="currentColor" stroke-width="1.6"/></svg><svg class="icone-olho-riscado" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 10s3.2-6 9-6 9 6 9 6-3.2 6-9 6-9-6-9-6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="10" cy="10" r="2.6" stroke="currentColor" stroke-width="1.6"/><path d="M2 2l16 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
                </div>

                <% if (usaFirebase) { %><div id="erroFirebase" class="erro" role="alert" tabindex="-1" hidden></div><p id="statusFirebase" role="status" aria-live="polite"></p><noscript>Ative o JavaScript para acessar com e-mail e senha.</noscript><% } %>
                <button type="submit" class="btn-principal" <%= usaFirebase ? 'disabled' : '' %>>Entrar</button>
                <% if (usaFirebase) { %>
                <div class="auth-alternativa"><span>ou</span></div>
                <button type="button" id="entrarGoogle" class="btn-google" disabled>Entrar com Google</button>
                <p class="auth-google-aviso">No primeiro acesso com Google, uma nova conta será criada se não houver conflito com uma conta existente.</p>
                <% } %>
            </form>

            <% if (usaFirebase) { %><p><a href="/login?legado=1">Já usava o Bikonfig? Acessar com usuário e senha</a></p><% } %>
            <% if (temFirebase && !usaFirebase) { %><p><a href="/login">Acessar com e-mail pelo Firebase</a></p><% } %>
            <div class="info-demo">
                <small>Não tem conta? <a href="/cadastro<%= sufixoLegado %>">Criar conta</a></small>
            </div>
        </div>
    </main>

    <footer class="rodape">
        <div class="container">
            <p>Bikonfig - Configurador de bicicletas</p>
        </div>
    </footer>

    <script src="/js/auth.js"></script>
    <% if (usaFirebase) { %><script src="/js/firebase-auth.bundle.js"></script><% } %>
</body>
</html>
