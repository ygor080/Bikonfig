<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurador - Bikonfig</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/estilo.css">
    <link rel="stylesheet" href="/css/configurador.css">
</head>
<body class="pagina-configurador">
    <header class="cabecalho">
        <div class="container">
            <a href="/" class="logo">Bikonfig</a>
            <button type="button" class="menu-toggle" id="menuToggle" aria-expanded="false" aria-controls="navPrincipal" aria-label="Abrir menu">
                <span></span><span></span><span></span>
            </button>
            <nav class="nav" id="navPrincipal">
                <span class="usuario-nome"><%= usuario.nome %></span>
                <a href="/home">Home</a>
                <a href="/catalogo">Catalogo</a>
                <a href="/catalogo/configurador">Configurador</a>
                <a href="/catalogo/minhas-configuracoes">Minhas configs</a>
                <% if (usuario.isAdmin) { %><a href="/admin/revisao">Revisão</a><% } %>
                <form method="POST" action="/logout" class="form-sair"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"><button type="submit" class="sair">Sair</button></form>
            </nav>
        </div>
    </header>

    <nav class="config-atalhos" aria-label="Atalhos do configurador">
        <a href="#configMenu">Categorias</a>
        <a href="#configListaPecas">Peças</a>
        <a href="#configResumo">Resumo e salvar</a>
    </nav>
    <main class="config-wrapper">
        <aside class="config-menu" id="configMenu" tabindex="-1" aria-labelledby="configTituloCategorias" data-usuario-id="<%= usuario.id %>" data-completude-inicial="<%= JSON.stringify(typeof completudeInicial !== 'undefined' ? completudeInicial : null) %>">
            <h2 class="config-menu-titulo" id="configTituloCategorias">Categorias de peças</h2>
            <input type="hidden" id="configCompletudesPorTipo" value="<%= JSON.stringify(typeof completudesPorTipo !== 'undefined' ? completudesPorTipo : {}) %>">
            <% categorias.forEach(function(grupo) { %>
                <div class="config-grupo" data-grupo="<%= grupo.slug %>">
                    <button type="button" class="config-grupo-btn" aria-expanded="false" aria-controls="subitens-<%= grupo.slug %>">
                        <span class="config-nome-categoria"><span><%= grupo.nome %></span><span class="config-obrigatorio config-obrigatorio-grupo" role="img" aria-label="Há componentes essenciais pendentes neste grupo" hidden></span></span>
                        <span class="config-grupo-seta">▾</span>
                    </button>
                    <ul class="config-subitens" id="subitens-<%= grupo.slug %>" hidden>
                        <% grupo.subcategorias.forEach(function(sub) { %>
                            <li>
                                <button type="button"
                                    class="config-subitem-btn"
                                    data-subcategoria="<%= sub.slug %>"
                                    data-nome="<%= sub.nome %>">
                                    <span class="config-nome-categoria"><span><%= sub.nome %></span><span class="config-obrigatorio" data-obrigatorio="<%= sub.slug %>" role="img" hidden></span></span>
                                    <span class="config-check" data-check="<%= sub.slug %>"></span>
                                </button>
                            </li>
                        <% }); %>
                    </ul>
                </div>
            <% }); %>
        </aside>

        <section class="config-central">
            <div class="config-visual" id="configVisual">
                <svg viewBox="0 0 600 320" id="bikeSvg" xmlns="http://www.w3.org/2000/svg">
                    <circle id="parte-roda-traseira" cx="140" cy="230" r="70" fill="none" stroke="#ccc" stroke-width="10"/>
                    <circle id="parte-roda-dianteira" cx="460" cy="230" r="70" fill="none" stroke="#ccc" stroke-width="10"/>
                    <polyline id="parte-quadro" points="140,230 260,110 380,110 460,230 260,110 300,230 140,230"
                        fill="none" stroke="#999" stroke-width="8" stroke-linejoin="round" stroke-linecap="round"/>
                    <line id="parte-suspensao" x1="380" y1="110" x2="460" y2="230" stroke="#999" stroke-width="10" stroke-linecap="round"/>
                    <line id="parte-cockpit" x1="380" y1="110" x2="420" y2="80" stroke="#999" stroke-width="8" stroke-linecap="round"/>
                    <line id="parte-selim" x1="260" y1="110" x2="245" y2="80" stroke="#999" stroke-width="8" stroke-linecap="round"/>
                    <circle id="parte-transmissao" cx="300" cy="230" r="26" fill="none" stroke="#999" stroke-width="6"/>
                    <circle id="parte-freios-d" cx="460" cy="230" r="18" fill="none" stroke="#999" stroke-width="4"/>
                    <circle id="parte-freios-t" cx="140" cy="230" r="18" fill="none" stroke="#999" stroke-width="4"/>
                    <circle id="parte-acessorios" cx="300" cy="230" r="6" fill="#999"/>
                </svg>
                <p class="config-visual-aviso">Ilustração da montagem. Confira as medidas e as especificações das peças antes de comprar.</p>
            </div>

            <div class="config-lista-pecas" id="configListaPecas" tabindex="-1" aria-label="Peças da categoria">
                <p class="config-lista-vazio">Selecione uma categoria ao lado para ver as peças disponíveis.</p>
            </div>
        </section>

        <aside class="config-orcamento" id="configResumo" tabindex="-1" aria-label="Resumo e salvamento">
            <div class="config-resumo-cabecalho">
                <h2 class="config-menu-titulo">Resumo da configuração</h2>
                <button type="button" id="btnComponentesEssenciais" class="config-detalhes-componentes" data-estado="incompleta"
                    aria-expanded="false" aria-controls="configCompletude" aria-label="Faltam componentes essenciais. Ver detalhes."
                    title="Faltam componentes essenciais. Ver detalhes.">Ver detalhes</button>
            </div>
            <span id="configEstadoComponentes" class="texto-acessivel" role="status" aria-live="polite">Faltam componentes essenciais.</span>
            <section id="configCompletude" class="config-completude" aria-label="Detalhes dos componentes essenciais" hidden>
                <p>Selecione peças para conferir os componentes essenciais faltantes.</p>
            </section>
            <label for="tipoMontagem">Tipo de montagem</label>
            <select id="tipoMontagem" class="config-tipo-montagem">
                <option value="com-marchas">Com marchas — sem suspensão traseira</option>
                <option value="single-speed">Single-speed — sem suspensão traseira</option>
                <option value="suspensao-total">Com marchas — suspensão dianteira e traseira</option>
            </select>
            <ul class="config-orcamento-lista" id="orcamentoLista">
                <li class="config-orcamento-vazio">Nenhuma peça selecionada ainda.</li>
            </ul>
            <div class="config-avisos" id="configAvisos"></div>
            <div class="config-avisos" id="configCompatibilidade" role="status" aria-live="polite"></div>
            <div class="config-avisos" id="configIndisponiveis" role="status"></div>
            <div class="config-total">
                <span>Total</span>
                <strong id="orcamentoTotal" role="status" aria-live="polite">R$ 0,00</strong>
            </div>
            <button type="button" class="btn-secundario" id="btnAtualizarOrcamento">Atualizar orçamento</button>
            <button type="button" class="btn-secundario" id="btnLimparConfig">Limpar seleção</button>
            <p id="configEdicao" role="status" aria-live="polite"></p>
            <p id="configRascunho" role="status" aria-live="polite">O progresso é recuperado neste navegador. Use Salvar para guardar a montagem na sua conta.</p>
            <button type="button" class="btn-principal" id="btnSalvarConfig">
                Salvar configuração
            </button>
            <button type="button" class="btn-secundario" id="btnBaixarPdf">
                Baixar PDF
            </button>
        </aside>
    </main>

    <footer class="rodape">
        <div class="container">
            <p>Bikonfig - Configurador de bicicletas</p>
        </div>
    </footer>

    <script src="/js/conteudo-seguro.js"></script>
    <script src="/js/rascunho-configuracao.js"></script>
    <script src="/js/app.js"></script>
    <script src="/js/configurador.js"></script>
</body>
</html>
