DATABASE_URL=COLE_A_CONNECTION_STRING_URI_DO_SUPABASE_AQUI
SECRET=troque-esta-chave-de-sessao-por-uma-string-longa-e-aleatoria
PORT=3000
# No Render, use production para cookies exclusivamente HTTPS.
NODE_ENV=development

# Firebase: habilita a integração de sessão do backend a partir da etapa 32.
# Telas Firebase e migração das contas são etapas posteriores; login atual permanece disponível.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# Declare somente hostnames; a lista também precisa ser configurada no console.
FIREBASE_AUTHORIZED_DOMAINS_JSON=["localhost","127.0.0.1","bikonfig.onrender.com"]
# Credencial privada somente no servidor, fora do repositório/public/.
# No Render, um Secret File pode ficar em /etc/secrets/firebase-admin.json.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/privado/firebase-admin.json
